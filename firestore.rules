rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    // User Validator
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'department', 'createdAt', 'updatedAt']) &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 120 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.role in ['Doctor', 'Nurse', 'Admin', 'Staff'] &&
             (!('department' in data) || (data.department is string && data.department.size() <= 80));
    }

    // Patient Validator
    function isValidPatient(data) {
      return data.keys().hasAll(['id', 'fullName', 'phone', 'bloodGroup', 'visitCount', 'visits']) &&
             data.id is string && data.id.size() <= 64 &&
             data.fullName is string && data.fullName.size() <= 120 &&
             data.phone is string && data.phone.size() <= 32 &&
             data.bloodGroup in ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-'] &&
             data.visitCount is number && data.visitCount >= 1 &&
             data.visits is list && data.visits.size() >= 1 && data.visits.size() <= 100 &&
             (!('age' in data) || (data.age is number && data.age >= 0 && data.age <= 150)) &&
             (!('allergies' in data) || (data.allergies is list && data.allergies.size() <= 50)) &&
             (!('chronicConditions' in data) || (data.chronicConditions is list && data.chronicConditions.size() <= 50));
    }

    // Doctor Validator
    function isValidDoctor(data) {
      return data.keys().hasAll(['id', 'name', 'department', 'status']) &&
             data.id is string && data.id.size() <= 64 &&
             data.name is string && data.name.size() <= 100 &&
             data.department is string && data.department.size() <= 80 &&
             data.status in ['Available', 'In Consultation', 'In Surgery', 'On Break', 'Off Duty'];
    }

    // Disease Report Validator
    function isValidDisease(data) {
      return data.keys().hasAll(['id', 'name', 'category', 'icd10', 'severity']) &&
             data.id is string && data.id.size() <= 64 &&
             data.name is string && data.name.size() <= 140 &&
             data.icd10 is string && data.icd10.size() <= 20 &&
             data.severity in ['Mild', 'Moderate', 'Severe', 'Critical'];
    }

    // Anatomical Risk Validator
    function isValidRisk(data) {
      return data.keys().hasAll(['id', 'name', 'riskLevel', 'riskScore']) &&
             data.id is string && data.id.size() <= 64 &&
             data.name is string && data.name.size() <= 100 &&
             data.riskLevel in ['Critical', 'High', 'Moderate', 'Normal'] &&
             data.riskScore is number && data.riskScore >= 0 && data.riskScore <= 100;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || resource.data.uid == request.auth.uid);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUser(incoming());
      allow delete: if false;
    }

    // Patients Collection (Hospital Electronic Health Records)
    match /patients/{patientId} {
      allow get: if isSignedIn() && isValidId(patientId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(patientId) && isValidPatient(incoming());
      allow update: if isSignedIn() && isValidId(patientId) && isValidPatient(incoming());
      allow delete: if isSignedIn() && isValidId(patientId);
    }

    // Doctors Collection (Live Staff Roster)
    match /doctors/{doctorId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidId(doctorId) && isValidDoctor(incoming());
      allow update: if isSignedIn() && isValidId(doctorId) && isValidDoctor(incoming());
      allow delete: if isSignedIn() && isValidId(doctorId);
    }

    // Disease Reports Collection
    match /disease_reports/{diseaseId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidId(diseaseId) && isValidDisease(incoming());
      allow update: if isSignedIn() && isValidId(diseaseId) && isValidDisease(incoming());
      allow delete: if isSignedIn() && isValidId(diseaseId);
    }

    // Anatomical Risks Collection (Hologram Visualizer Data)
    match /anatomical_risks/{riskId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidId(riskId) && isValidRisk(incoming());
      allow update: if isSignedIn() && isValidId(riskId) && isValidRisk(incoming());
      allow delete: if isSignedIn() && isValidId(riskId);
    }

    // Overview Metrics Collection (Hospital Telemetry & Capacity)
    match /overview_metrics/{metricId} {
      allow get, list: if true;
      allow create, update: if isSignedIn() && isValidId(metricId);
      allow delete: if false;
    }
  }
}
